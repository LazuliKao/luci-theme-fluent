{
  "name": "luci-theme-fluent",
  "version": "1.0.8",
  "type": "module",
  "description": "FluentUI theme for OpenWrt LuCI",
  "scripts": {
    "css:build": "cd src && pnpm exec rsbuild build --environment css",
    "build:js": "cd src && pnpm exec rsbuild build --environment js",
    "build": "cd src && pnpm run build",
    "watch:css": "cd src && pnpm exec rsbuild build --environment css --watch",
    "watch:js": "cd src && pnpm exec rsbuild build --environment js --watch",
    "watch": "cd src && pnpm run watch",
    "lint": "biome lint --no-errors-on-unmatched package/luci-theme-fluent/htdocs src/web/resources",
    "format": "biome format --write --no-errors-on-unmatched package/luci-theme-fluent/htdocs src/web/resources",
    "i18n:extract-ucode": "tsx src/script/extract-ucode.ts",
    "i18n:extract": "pnpm run i18n:extract-ucode -- --generate && luci-types i18n --no-translate",
    "i18n:build": "pnpm run i18n:extract-ucode -- --generate && dotenvx run -- luci-types i18n",
    "test": "echo \"No tests yet\" && exit 0",
    "test:menu-layout": "tsx --test src/web/resources/menu-layout.test.ts",
    "dev:remote": "luci-types dev",
    "icons:generate": "tsx src/script/generate-icons.ts",
    "screenshot": "pnpm run screenshot:run && pnpm run screenshot:showcase && pnpm run screenshot:run:zh-Hans && pnpm run screenshot:showcase:zh-Hans",
    "screenshot:run": "tsx src/script/screenshot/run.ts",
    "screenshot:showcase": "tsx src/script/screenshot/generate-showcase.ts",
    "screenshot:run:zh-Hans": "tsx src/script/screenshot/run.ts -- --lang=zh-Hans",
    "screenshot:showcase:zh-Hans": "tsx src/script/screenshot/generate-showcase.ts -- --lang=zh-Hans",
    "typecheck": "cd src && pnpm exec tsc -p tsconfig.json --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@dotenvx/dotenvx": "^2.19.1",
    "@iconify-json/fluent": "^1.2.51",
    "@iconify-json/fluent-mdl2": "^1.2.1",
    "@lazulikao/luci-types": "github:LazuliKao/luci-types#6511175eddeb9dcdee0046f3399b604ce74bd99c",
    "@types/node": "^22.19.21",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright": "^1.61.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.4"
}
