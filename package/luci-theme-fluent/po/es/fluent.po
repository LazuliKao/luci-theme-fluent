msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in dark mode."
msgstr ""
"Se utiliza un color HEX como acento principal de Fluent cuando la interfaz "
"se muestra en modo oscuro."

msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in light mode."
msgstr ""
"Se utiliza un color HEX como acento principal de Fluent cuando la interfaz "
"se muestra en modo claro."

msgid "HEX color used for container/card elements in dark mode."
msgstr "Color HEX utilizado para los elementos de contenedor/tarjeta en modo oscuro."

msgid "HEX color used for container/card elements in light mode."
msgstr "Color HEX utilizado para los elementos de contenedor/tarjeta en modo claro."

msgid ""
"HEX color used for progress-bar labels while the interface is rendered in "
"dark mode."
msgstr ""
"Se utiliza un código de color hexadecimal para las etiquetas de la barra de "
"progreso cuando la interfaz se muestra en modo oscuro."

msgid ""
"HEX color used for progress-bar labels while the interface is rendered in "
"light mode."
msgstr ""
"Se utiliza un código de color hexadecimal para las etiquetas de la barra de "
"progreso cuando la interfaz se muestra en modo claro."

msgid "HEX color used for the main page background in dark mode."
msgstr "Color HEX utilizado para el fondo de la página principal en modo oscuro."

