msgstr "Por favor, ingrese su contraseña."

msgid "Please enter your username."
msgstr "Por favor, ingrese su nombre de usuario."

msgid ""
"Position of progress-bar labels relative to the bar. Start/end alignment "
"follows the text direction (LTR or RTL)."
msgstr ""
"Posición de las etiquetas de la barra de progreso en relación con la barra. "
"La alineación de inicio/fin sigue la dirección del texto (LTR o RTL)."

