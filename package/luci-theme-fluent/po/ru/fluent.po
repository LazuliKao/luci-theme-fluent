msgstr ""
"Токену НЕ требуются дополнительные разрешения или области доступа "
"(достаточно публичного доступа только для чтения)."

msgid "Theme settings"
msgstr "Настройки темы"

msgid ""
"Theme successfully updated! Reloading RPC service, please refresh the page "
