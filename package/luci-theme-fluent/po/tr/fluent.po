msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in dark mode."
msgstr ""
"Arayüz karanlık modda görüntülendiğinde kullanılan birincil Fluent vurgu "
"rengi (HEX)."

msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in light mode."
msgstr ""
"Arayüz açık modda görüntülendiğinde kullanılan birincil Fluent vurgu rengi "
"(HEX)."

msgid "HEX color used for container/card elements in dark mode."
msgstr "Karanlık modda kullanılan konteyner/kart elemanları için HEX renk."

msgid "HEX color used for container/card elements in light mode."
msgstr "Açık modda kullanılan konteyner/kart elemanları için HEX renk."

msgid ""
"HEX color used for progress-bar labels while the interface is rendered in "
