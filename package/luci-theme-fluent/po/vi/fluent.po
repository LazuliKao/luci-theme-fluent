msgstr "Vui lòng nhập tên người dùng của bạn."

msgid ""
"Position of progress-bar labels relative to the bar. Start/end alignment "
"follows the text direction (LTR or RTL)."
msgstr ""
"Vị trí nhãn của thanh tiến trình so với thanh. Căn chỉnh bắt đầu/kết thúc "
"theo hướng văn bản (trái-phải hoặc phải-trái)."

msgid "Preset Vendor / Generator"
msgstr "Nhà cung cấp / Trình tạo mặc định"

