msgstr ""
"Thay thế các phần tử select mặc định bằng widget dropdown tùy chỉnh của chủ "
"đề."

msgid "Respect reduced-motion preference"
msgstr "Tuân thủ cài đặt giảm hiệu ứng chuyển động"

