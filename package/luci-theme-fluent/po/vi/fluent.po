"HEX color used for progress-bar labels while the interface is rendered in "
"dark mode."
msgstr ""
"Màu HEX được sử dụng cho nhãn thanh tiến trình khi giao diện hiển thị ở chế "
"độ tối."

msgid ""
"HEX color used for progress-bar labels while the interface is rendered in "
"light mode."
msgstr ""
"Màu HEX được sử dụng cho nhãn thanh tiến trình khi giao diện hiển thị ở chế "
"độ sáng."

msgid "HEX color used for the main page background in dark mode."
msgstr "Màu HEX được sử dụng cho nền trang chính trong chế độ tối."

msgid "HEX color used for the main page background in light mode."
msgstr "Màu HEX được sử dụng cho nền trang chính trong chế độ sáng."

msgid "HEX color used for the navigation sidebar in dark mode."
msgstr "Màu HEX được sử dụng cho thanh bên điều hướng ở chế độ tối."

msgid "HEX color used for the navigation sidebar in light mode."
msgstr "Màu HEX được sử dụng cho thanh bên điều hướng ở chế độ sáng."

