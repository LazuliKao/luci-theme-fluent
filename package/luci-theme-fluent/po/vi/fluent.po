msgstr "Chiều cao của thanh tiêu đề phía trên, tính bằng pixel."

msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in dark mode."
msgstr ""
"Màu HEX được sử dụng làm màu nhấn chính của Fluent khi giao diện hiển thị ở "
"chế độ tối."

msgid ""
"HEX color used as the primary Fluent accent when the interface is rendered "
"in light mode."
msgstr ""
"Màu HEX được sử dụng làm màu nhấn chính của Fluent khi giao diện hiển thị ở "
"chế độ sáng."

