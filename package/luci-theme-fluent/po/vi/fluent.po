msgstr ""
"Sử dụng View Transition API của trình duyệt để tạo hiệu ứng động khi chuyển "
"giữa các trang LuCI, nếu được hỗ trợ."

msgid ""
"Use the system/browser preference, or always render the Fluent theme in a "
"fixed light or dark palette."
msgstr ""
"Sử dụng cài đặt ưu tiên của hệ thống/trình duyệt, hoặc luôn hiển thị giao "
"diện Fluent với bảng màu sáng hoặc tối cố định."

msgid "Username is required."
msgstr "Tên người dùng là bắt buộc."

